generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  phone          String?
  whatsapp       String?
  role           Role
  status         UserStatus      @default(ACTIVE)
  profile        Profile?
  properties     Property[]      @relation("LandlordProperties")
  rentalRequests RentalRequest[]
  tourRequests   TourRequest[]   @relation("TenantTours")
  reviews        Review[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model Profile {
  id               String  @id @default(uuid())
  bio              String?
  photo            String?
  address          String?
  emailSupportText String?
  phoneSupportText String?
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id])
}

model Property {
  id             String          @id @default(uuid())
  title          String
  description    String
  location       String
  price          Float
  rentType       String?
  rentNegotiable Boolean         @default(false)
  floorArea      Int?
  rentFor        String[]
  bedrooms       Int?
  bathrooms      Int?
  balcony        Int?
  floorLevel     String?
  gas            String?
  parking        String?
  lift           String?
  furnished      String?
  facing         String?
  serviceCharge  Float?
  availableFrom  DateTime?
  amenities      String[]
  videoLink      String?
  newBuild       String?
  propertyType   String?
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  landlordId     String
  landlord       User            @relation("LandlordProperties", fields: [landlordId], references: [id])
  rentalRequests RentalRequest[]
  tourRequests   TourRequest[]
  reviews        Review[]
  createdAt      DateTime        @default(now())
  image          String?
  images         String[]
  isAvailable    Boolean         @default(true)
}

model Category {
  id         String     @id @default(uuid())
  name       String     @unique
  properties Property[]
}

model RentalRequest {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     User      @relation(fields: [tenantId], references: [id])
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id])
  startDate  DateTime
  endDate    DateTime
  status     Status    @default(PENDING)
  payments   Payment[]
  createdAt  DateTime  @default(now())
}

model TourRequest {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     User     @relation("TenantTours", fields: [tenantId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  status     Status   @default(PENDING)
  createdAt  DateTime @default(now())
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
}

model Payment {
  id              String        @id @default(uuid())
  transactionId   String        @unique
  rentalRequestId String
  rentalRequest   RentalRequest @relation(fields: [rentalRequestId], references: [id])
  amount          Float
  status          String
  paidAt          DateTime      @default(now())
}

model Review {
  id         String   @id @default(uuid())
  content    String
  rating     Int
  tenantId   String
  tenant     User     @relation(fields: [tenantId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SavedSearch {
  id               String   @id @default(uuid())
  searchTerm       String?
  selectedLocation String?
  searchMode       String?
  selectedCategory String?
  propertyType     String?
  minPrice         String?
  maxPrice         String?
  beds             String?
  baths            String?
  createdAt        DateTime @default(now())
}